{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alikarami76/keygraph",
  "title": "keygraph",
  "description": "Schema map for SQL agents: join paths with fan-out warnings, grain, codes. Read-only, no LLM.",
  "repository": {
    "url": "https://github.com/alikarami76/keygraph",
    "source": "github"
  },
  "websiteUrl": "https://github.com/alikarami76/keygraph",
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "keygraph",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {"type": "named", "name": "--from", "value": "keygraph[mcp]==0.4.0"}
      ],
      "transport": {"type": "stdio"},
      "packageArguments": [
        {"type": "positional", "value": "mcp"},
        {
          "type": "named",
          "name": "--dir",
          "description": "Absolute path of a keygraph output folder (build one with keygraph scan, load or demo)",
          "isRequired": true,
          "format": "filepath"
        }
      ]
    }
  ]
}
