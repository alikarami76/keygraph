{
  "$description": "keygraph design tokens. Source of truth for keygraph.css (variables block) and cytoscape-style.js (theme objects). Regenerate both with: python3 design/build.py",
  "$version": "1.0.0",
  "font": {
    "sans": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "files": {
      "Inter": {
        "file": "fonts/Inter-latin.var.woff2",
        "weight": "100 900",
        "license": "fonts/OFL-Inter.txt"
      },
      "JetBrains Mono": {
        "file": "fonts/JetBrainsMono-latin.var.woff2",
        "weight": "100 800",
        "license": "fonts/OFL-JetBrainsMono.txt"
      }
    }
  },
  "type": {
    "$note": "size / line-height in px. 'mono' styles are for identifiers, types, SQL and numbers.",
    "caption": {
      "size": 11,
      "line": 16,
      "weight": 500,
      "tracking": "0.02em"
    },
    "overline": {
      "size": 11,
      "line": 16,
      "weight": 600,
      "tracking": "0.06em",
      "case": "uppercase"
    },
    "small": {
      "size": 12,
      "line": 18,
      "weight": 400
    },
    "body": {
      "size": 13,
      "line": 20,
      "weight": 400
    },
    "body-strong": {
      "size": 13,
      "line": 20,
      "weight": 550
    },
    "large": {
      "size": 14,
      "line": 22,
      "weight": 400
    },
    "title": {
      "size": 16,
      "line": 24,
      "weight": 600,
      "tracking": "-0.01em"
    },
    "heading": {
      "size": 20,
      "line": 28,
      "weight": 600,
      "tracking": "-0.015em"
    },
    "display": {
      "size": 28,
      "line": 34,
      "weight": 650,
      "tracking": "-0.02em"
    },
    "mono-small": {
      "size": 11.5,
      "line": 16,
      "weight": 400,
      "family": "mono"
    },
    "mono": {
      "size": 12.5,
      "line": 18,
      "weight": 400,
      "family": "mono"
    },
    "mono-title": {
      "size": 15,
      "line": 22,
      "weight": 550,
      "family": "mono",
      "tracking": "-0.01em"
    }
  },
  "space": {
    "0": 0,
    "px": 1,
    "0.5": 2,
    "1": 4,
    "1.5": 6,
    "2": 8,
    "2.5": 10,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "xs": 3,
    "sm": 5,
    "md": 7,
    "lg": 10,
    "xl": 14,
    "full": 999
  },
  "size": {
    "control-sm": 24,
    "control": 30,
    "control-lg": 36,
    "header": 52,
    "panel": 380,
    "panel-min": 340,
    "panel-max": 560,
    "statusbar": 28,
    "rail": 224
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "layout": "360ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in": "cubic-bezier(0.3, 0, 1, 1)",
    "ease-out": "cubic-bezier(0, 0, 0, 1)",
    "$note": "Under prefers-reduced-motion every duration becomes 0ms and graph layouts run without animation."
  },
  "z": {
    "canvas": 0,
    "overlay": 10,
    "panel": 20,
    "popover": 40,
    "toast": 60,
    "dialog": 80
  },
