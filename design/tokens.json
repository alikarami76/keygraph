  "graph": {
    "$note": "Geometry shared by both themes. Sizes in px at zoom 1.",
    "node": {
      "table": {
        "shape": "round-rectangle",
        "size-by-hop": [
          40,
          26,
          18,
          13,
          10,
          8
        ],
        "aspect": 1.0
      },
      "column": {
        "shape": "ellipse",
        "size": 10
      },
      "concept": {
        "shape": "round-diamond",
        "size": 22,
        "fill": "hollow"
      },
      "metric": {
        "shape": "round-hexagon",
        "size": 22,
        "fill": "hollow"
      },
      "schema": {
        "shape": "ellipse",
        "size-min": 28,
        "size-max": 96,
        "scale": "sqrt(tables)"
      },
      "border": {
        "default": 1.5,
        "focus": 3,
        "selected": 2.5
      },
      "polymorphic": {
        "border-style": "dashed",
        "border-color": "edge-poly"
      }
    },
    "edge": {
      "declared": {
        "line-style": "solid",
        "width": 1.6,
        "arrow": "triangle"
      },
      "inferred": {
        "line-style": "dashed",
        "dash": [
          5,
          4
        ],
        "width-by-confidence": [
          0.8,
          1.8
        ],
        "arrow": "triangle"
      },
      "concept": {
        "line-style": "dotted",
        "width": 1.4,
        "arrow": "none"
      },
      "polymorphic": {
        "line-style": "dashed",
        "dash": [
          1,
          3,
          6,
          3
        ],
        "width": 1.4,
        "arrow": "triangle",
        "source-arrow": "diamond"
      },
      "path": {
        "width": 3,
        "arrow": "triangle"
      },
      "opacity-by-confidence": {
        "0.4": 0.25,
        "0.6": 0.45,
        "0.8": 0.7,
        "0.95": 0.9,
        "1.0": 1.0
      },
      "arrow-scale": 0.7
    },
    "confidence": {
      "$note": "Bands drive chip colour and the default 'min confidence' preset.",
      "high": {
        "min": 0.9,
        "label": "high"
      },
      "medium": {
        "min": 0.7,
        "label": "medium"
      },
      "low": {
        "min": 0.0,
        "label": "low"
      }
    },
    "label": {
      "size": 11,
      "size-focus": 13,
      "family": "mono",
      "max-width": 140,
      "halo": 3,
      "rule": "Always label hop 0 and hop 1. Label hop 2 when zoom >= 0.9. Label hop 3+ only on hover, search match or selection."
    },
    "dim": {
      "node-opacity": 0.18,
      "edge-opacity": 0.08,
      "label-opacity": 0
    }
